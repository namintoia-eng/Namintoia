# IntelligenceProvider adapters (D-5) — au moins un requis pour des appels réels
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# BackendProvider — Postgres/GoTrue/PostgREST auto-hébergés (D-4)
DATABASE_URL=
AUTH_SERVICE_URL=
STORAGE_SERVICE_URL=

# SandboxProvider — E2B, microVM Firecracker managé (D-3/D-8)
E2B_API_KEY=

# PaymentProvider (D-6) — hors MVP, interface définie mais non branchée
PAYMENT_PROVIDER_API_KEY=

# GoogleOAuth pour UserSystem.authenticateExternal (D-18) — "Continuer avec Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clé HMAC du nonce anti-CSRF du flux OAuth — volontairement indépendante de GOOGLE_CLIENT_SECRET
AUTH_STATE_SECRET=

APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Exposed to the browser bundle by Next.js (must keep the NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_API_URL=http://localhost:3001
